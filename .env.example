# ============================================================
# 山川園芸 環境変数
# ------------------------------------------------------------
# ローカル開発では、このファイルを .env.local としてコピーし、
# 値を入れてください（.env.local は Git に含まれません）。
# 本番では Vercel の Settings > Environment Variables に設定します。
# APIキーは絶対にコードへ直接書かないこと。
# ============================================================

# --- 必須 ---------------------------------------------------
# 本番の公開URL（末尾のスラッシュなし）
#
# これが未設定のあいだ、サイトは
#   ・canonical / OGPのURL を出力しない
#   ・sitemap.xml を空にする
#   ・robots.txt を「全ページ Disallow」にする
#   ・Googleショッピング用フィードを空にする
# という状態になります。プレビューURLが検索結果に出るのを防ぐためです。
# 本番ドメインが決まったら必ず設定してください。
NEXT_PUBLIC_SITE_URL=https://example.com


# --- 決済（Stripeを接続するとき） ---------------------------
# 1. npm install stripe
# 2. 下の2つを設定
# 3. src/app/api/checkout/route.ts の TODO を実装
# 4. src/data/siteConfig.ts の checkoutConfig.provider を "stripe" に変更
#
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx


# --- お問い合わせフォーム（自社フォームを作るとき） ---------
# メール送信サービスのAPIキー。
# あわせて src/data/siteConfig.ts の contactConfig を設定してください。
#
# RESEND_API_KEY=re_xxxxxxxxxxxx
# CONTACT_TO_EMAIL=info@example.com
