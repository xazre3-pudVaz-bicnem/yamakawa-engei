# ============================================================
# 山川園芸 環境変数
# ------------------------------------------------------------
# ローカル開発では、このファイルを .env.local としてコピーし、
# 値を入れてください（.env.local は Git に含まれません）。
# 本番では Vercel の Settings > Environment Variables に設定します。
# APIキーは絶対にコードへ直接書かないこと。
# ============================================================

# --- 決済（必須） -------------------------------------------
# Stripeダッシュボードの「開発者 > APIキー」から取得します。
#
# 公開可能キー。ブラウザで使うため NEXT_PUBLIC_ が付きます。
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
#
# シークレットキー。サーバー側でのみ使用します。
# 絶対に NEXT_PUBLIC_ を付けないこと（ブラウザに漏れます）。
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
#
# Webhookの署名検証に使います。
# Stripeダッシュボードの「開発者 > Webhook」でエンドポイントを
# 登録すると発行されます（whsec_ で始まる値）。
# 登録先URL: https://www.yamakawaengei.com/api/stripe/webhook
# 購読イベント: checkout.session.completed
#               checkout.session.async_payment_succeeded
#               checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx


# --- ブログ自動投稿（GitHub Actions で使用） -----------------
# GitHubリポジトリの Settings > Secrets and variables > Actions に登録します。
# Vercelには不要です。
#
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
#
# 任意。未設定なら Haiku（claude-haiku-4-5-20251001）を使います。
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# --- 任意 ---------------------------------------------------
# 本番ドメインは src/data/siteConfig.ts に直接書いてあります
#   PRODUCTION_URL = "https://www.yamakawaengei.com"
# 通常はこの環境変数を設定する必要はありません。
#
# 一時的に別のURLで動かしたいとき（別ドメインでの検証など）だけ、
# ここを設定するとそちらが優先されます。末尾のスラッシュは付けないこと。
#
# NEXT_PUBLIC_SITE_URL=https://example.com


# --- 注文確認メール（必須） ---------------------------------
# 未設定だと、ご注文が入っても農園にもお客様にもメールが届きません。
# 注文完了ページも「メールを送りました」と表示しません。
#
# 送信には Resend（https://resend.com）を使います。
# 1. Resendに登録し、Domains で yamakawaengei.com を認証する
#    （DNSレコードを追加します。認証しないと迷惑メール扱いになります）
# 2. API Keys でキーを作る（re_ で始まる値）
# 3. Vercel の環境変数に下記3つを登録して再デプロイする
#
RESEND_API_KEY=re_xxxxxxxxxxxx
#
# 差出人。認証したドメインのアドレスにすること。
ORDER_MAIL_FROM=山川園芸 <order@yamakawaengei.com>
#
# 新規注文の通知先（農園side）。
# 未設定の場合は src/data/siteConfig.ts の contactConfig.email に送ります。
ORDER_MAIL_TO=azisaibiyori@go5.enjoy.ne.jp
